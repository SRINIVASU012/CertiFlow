# CertiFlow Environment Configuration Example

# Node Environment
NODE_ENV=development
PORT=5000

# Frontend URL (for CORS and Certificate Verification links)
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
# When running backend locally on host:
DATABASE_URL=postgresql://certiflow_user:certiflow_password@localhost:5432/certiflow?schema=public
# When running backend inside Docker Compose:
# DATABASE_URL=postgresql://certiflow_user:certiflow_password@postgres:5432/certiflow?schema=public

# Redis Connection (BullMQ)
# When running backend locally on host:
REDIS_HOST=localhost
REDIS_PORT=6379
# When running backend inside Docker Compose:
# REDIS_HOST=redis
# REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=certiflow_super_secret_jwt_key_pragati_skills_2026
JWT_EXPIRES_IN=7d

# Batch Workflow Configuration
# Threshold number of candidates requiring Quality Review before State approval
QUALITY_REVIEW_THRESHOLD=50
# Delayed batch threshold in hours before senior reminder is triggered
DELAYED_BATCH_THRESHOLD_HOURS=24
